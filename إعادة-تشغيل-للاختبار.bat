@echo off
chcp 65001 >nul
title إعادة تشغيل الخادم للاختبار
color 0A

cls
echo ═══════════════════════════════════════════════════════════════════
echo                  🔄 إعادة تشغيل الخادم للاختبار
echo ═══════════════════════════════════════════════════════════════════
echo.

echo [1/3] إيقاف الخادم القديم...
taskkill /F /IM node.exe >nul 2>&1
timeout /t 2 >nul
echo ✅ تم إيقاف الخادم القديم

echo.
echo [2/3] تشغيل الخادم الجديد...
set PORT=3000
start "Penetration Testing Server" cmd /k "color 0A && echo ═══════════════════════════════════════════════════════════════════ && echo            🚀 خادم منصة اختبار الاختراق && echo            📝 تم تطبيق التحسينات على محرك الزحف && echo ═══════════════════════════════════════════════════════════════════ && echo. && echo ✅ الخادم يعمل على المنفذ 3000 && echo 🌐 الرابط: http://localhost:3000 && echo. && echo 💡 افتح Console (F12) لرؤية السجلات المفصلة && echo ═══════════════════════════════════════════════════════════════════ && echo. && node server-sqlite.js"

echo ✅ تم تشغيل الخادم الجديد

echo.
echo [3/3] انتظار تشغيل الخادم...
timeout /t 8 >nul
echo ✅ الخادم جاهز

echo.
echo ═══════════════════════════════════════════════════════════════════
echo                    ✅ تم إعادة التشغيل بنجاح!
echo ═══════════════════════════════════════════════════════════════════
echo.
echo 🔍 التحسينات المطبقة:
echo    ✅ تعطيل robots.txt مؤقتاً
echo    ✅ تقليل التأخير إلى 500ms
echo    ✅ إضافة سجلات مفصلة جداً
echo.
echo 📝 الآن جرب الفحص مرة أخرى:
echo    http://localhost:3000/test-web-scan-efficient.html
echo.
echo 💡 مهم جداً:
echo    اضغط F12 في المتصفح لفتح Console
echo    ستجد سجلات مفصلة جداً لكل خطوة
echo.
echo ═══════════════════════════════════════════════════════════════════
echo.

echo هل تريد فتح صفحة الاختبار الآن؟
set /p open_choice="[Y] نعم  [N] لا: "

if /i "%open_choice%"=="Y" (
    echo.
    echo جاري فتح صفحة الاختبار...
    start http://localhost:3000/test-web-scan-efficient.html
    echo ✅ تم فتح الصفحة
)

echo.
pause
