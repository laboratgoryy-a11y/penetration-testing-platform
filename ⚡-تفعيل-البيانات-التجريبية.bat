@echo off
chcp 65001 >nul
color 0A
cls

echo.
echo ═══════════════════════════════════════════════════════════════
echo    🚀 تفعيل البيانات التجريبية
echo ═══════════════════════════════════════════════════════════════
echo.
echo هذا السكربت سيضيف بيانات تجريبية لقاعدة البيانات
echo لجعل العدادات تعمل فوراً!
echo.
echo ═══════════════════════════════════════════════════════════════
echo.

echo [1/2] 📊 التحقق من قاعدة البيانات...
echo.

REM التحقق من وجود MySQL
where mysql >nul 2>nul
if %errorlevel% neq 0 (
    echo ❌ MySQL غير مثبت أو غير موجود في PATH
    echo.
    echo 💡 الحلول البديلة:
    echo    1. استخدم MySQL Workbench وافتح الملف: activate-database-demo-data.sql
    echo    2. استخدم phpMyAdmin وانسخ محتوى الملف
    echo    3. استخدم أي أداة MySQL أخرى
    echo.
    pause
    exit /b 1
)

echo ✅ MySQL موجود
echo.

echo [2/2] 💾 إضافة البيانات التجريبية...
echo.

REM تنفيذ السكربت
mysql -u root -p web_scanner < activate-database-demo-data.sql

if %errorlevel% equ 0 (
    echo.
    echo ═══════════════════════════════════════════════════════════════
    echo ✅ تم إضافة البيانات التجريبية بنجاح!
    echo ═══════════════════════════════════════════════════════════════
    echo.
    echo 📊 البيانات المضافة:
    echo    ✅ 2 فحص شبكات
    echo    ✅ 4 ثغرات شبكات
    echo    ✅ 5 أجهزة مكتشفة
    echo    ✅ 2 فحص ويب
    echo    ✅ 2 ثغرات ويب
    echo    ✅ 2 حملة تصيد
    echo.
    echo ═══════════════════════════════════════════════════════════════
    echo 🎯 الخطوة التالية:
    echo ═══════════════════════════════════════════════════════════════
    echo.
    echo 1. افتح المتصفح: http://localhost:3000
    echo 2. أعد تحميل الصفحة (F5)
    echo 3. ستجد الأرقام تعمل الآن! 🎉
    echo.
    echo العدادات في لوحة التحكم:
    echo    📊 فحوصات الشبكات: 2
    echo    🔍 الثغرات المكتشفة: 6
    echo    💻 الأجهزة المكتشفة: 5
    echo    🌐 فحوصات الويب: 2
    echo    📧 حملات التصيد: 2
    echo.
) else (
    echo.
    echo ═══════════════════════════════════════════════════════════════
    echo ❌ فشل إضافة البيانات
    echo ═══════════════════════════════════════════════════════════════
    echo.
    echo 💡 الأسباب المحتملة:
    echo    1. كلمة مرور MySQL خاطئة
    echo    2. قاعدة البيانات web_scanner غير موجودة
    echo    3. الجداول غير موجودة
    echo.
    echo 🔧 الحلول:
    echo    1. تأكد من تشغيل السيرفر أولاً: npm start
    echo    2. تأكد من إنشاء قاعدة البيانات
    echo    3. استخدم MySQL Workbench يدوياً
    echo.
)

echo ═══════════════════════════════════════════════════════════════
echo.
pause
