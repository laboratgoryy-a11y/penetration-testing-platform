{
  "name": "penetration-testing-platform",
  "version": "1.0.0",
  "description": "منصة اختبار الاختراق والأمن الهجومي",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "runner:dev": "ts-node-dev --respawn --transpile-only src/runner/index.ts",
    "runner:start": "node dist/runner/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:migrate": "ts-node src/database/migrate.ts",
    "setup:email": "bash install-email-packages.sh || install-email-packages.bat"
  },
  "keywords": [
    "security",
    "penetration-testing",
    "cybersecurity"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-nmap": "^4.0.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "robots-parser": "^3.0.1",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.0",
    "undici": "^7.20.0",
    "uuid": "^9.0.1",
    "xml2js": "^0.6.2",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^25.2.1",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.10.9",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@types/xml2js": "^0.4.14",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
